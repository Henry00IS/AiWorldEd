{
  "name": "aiworlded",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "vitest",
    "testrun": "vitest run",
    "dev": "vite --host",
    "build": "prettier --write --log-level silent . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "bun run format:check && bun run testrun && bun run build",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "desktop:dev": "electrobun dev",
    "desktop:build": "electrobun build --env=stable",
    "desktop:run": "electrobun run",
    "e2e:build": "vite build --mode e2e",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "e2e:preview": "vite preview --port 4173 --strictPort"
  },
  "trustedDependencies": [
    "cypress"
  ],
  "devDependencies": {
    "@cypress/webpack-batteries-included-preprocessor": "^4.2.0",
    "@cypress/webpack-preprocessor": "^7.1.1",
    "cypress": "^15.19.0",
    "electrobun": "^1.18.1",
    "jsdom": "^30.0.1",
    "pe-library": "^2.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "resedit": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
