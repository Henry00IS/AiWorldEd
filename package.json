{
  "name": "aiworlded",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "vitest",
    "testrun": "vitest run",
    "dev": "vite --host",
    "build": "prettier --write --log-level silent . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "bun run format:check && bun run testrun && bun run build",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "audit:agents": "bun scripts/audit_agents_compliance.ts",
    "codemod:at-imports": "bun scripts/codemod_at_imports.ts",
    "desktop:dev": "electrobun dev",
    "desktop:build": "electrobun build --env=stable",
    "desktop:run": "electrobun run",
    "collab:shared:sync": "bun scripts/collaboration_shared_sync.ts",
    "collab:shared:check": "bun scripts/collaboration_shared_sync.ts --check",
    "test:collab": "AIWORLDED_COLLAB_REQUIRED=1 vitest run tests/collaboration"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "electrobun": "^1.18.1",
    "jsdom": "^30.0.1",
    "pe-library": "^2.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "resedit": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@types/three": "^0.185.3",
    "three": "^0.185.1"
  }
}
